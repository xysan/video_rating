# MySQL 8 连接串；替换账号、密码和主机，特殊字符须 URL 编码
DATABASE_URL=mysql+pymysql://user:pass@localhost:3306/appdb
# 替换为随机生成的密钥，本 PR 尚未启用认证
JWT_SECRET=replace-with-random-secret
# JWT 有效期（分钟）
JWT_EXPIRE_MINUTES=60
# 前端地址，逗号分隔；开发可用 *，上线前必须收紧
CORS_ORIGINS=*
# 飞书应用 ID，后续同步 PR 填写
FEISHU_APP_ID=
# 飞书应用密钥
FEISHU_APP_SECRET=
# 飞书多维表格 app token
FEISHU_APP_TOKEN=
# 飞书数据表 ID
FEISHU_TABLE_ID=
# 增量同步间隔（分钟），本 PR 不执行同步
SYNC_INTERVAL_MINUTES=15
# 缺少凭证时保持关闭
FEISHU_SYNC_ENABLED=false
# 管理员种子密码，后续 PR 启用，本 PR 不创建用户
SEED_ADMIN_PASSWORD=

# 飞书表的必填字段名称，支持查找引用值
FEISHU_UP_NAME_FIELD=up主
FEISHU_TITLE_FIELD=标题
FEISHU_PUBLISH_DATE_FIELD=发布时间
